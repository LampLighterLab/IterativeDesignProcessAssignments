% MAE 2250 handout style
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mae2250-handout}[2026/02/04 MAE 2250 handout style]

% --- Page + typography ---
\RequirePackage[margin=1in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[skip=10pt plus1pt, indent=0pt]{parskip}
\RequirePackage[many]{tcolorbox}    	% for COLORED BOXES (tikz and xcolor included)

% --- Unicode punctuation compatibility (for XeLaTeX/LuaLaTeX with legacy fonts) ---
\RequirePackage{iftex}
\ifPDFTeX\else
  \RequirePackage{newunicodechar}
  \newunicodechar{“}{``}
  \newunicodechar{”}{''}
  \newunicodechar{‘}{`}
  \newunicodechar{’}{'}
  \newunicodechar{–}{--}
  \newunicodechar{—}{---}
\fi

% --- Utilities ---
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{fancyhdr}
\RequirePackage{subcaption}
\RequirePackage{amsmath}
\RequirePackage{xspace} 
\RequirePackage[super]{nth}

\hypersetup{
  colorlinks=true,
  linkcolor=blue,
  urlcolor=blue,
  citecolor=blue
}

% --- Lists: compact, readable ---
% If `parskip` is used, it sets list `\parsep` to `\parskip`; explicitly zero it so
% blank lines in the source don't create large vertical gaps inside lists.
\setlist[itemize]{leftmargin=1.2em, itemsep=0.25em, topsep=0.25em, parsep=0pt, partopsep=0pt}
\setlist[enumerate]{leftmargin=1.6em, itemsep=0.25em, topsep=0.25em, parsep=0pt, partopsep=0pt}

% --- Header/footer ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[R]{\thepage}
\setlength{\headheight}{14pt}

% --- Course metadata (edit in one place per course/semester) ---
\newcommand{\CourseCode}{MAE 2250}
\newcommand{\CourseTitle}{Introduction to Mechanical Design}
\newcommand{\Semester}{Spring 2026}

% --- Handout metadata (edit per handout) ---
\newcommand{\HandoutType}{Assignment}
\newcommand{\HandoutNumber}{}
\newcommand{\HandoutTitle}{}
\newcommand{\DueDate}{}
\newcommand{\TeamType}{}
\newcommand{\TotalPoints}{}
\newcommand{\dock}{\textbf{dock}\xspace}
\newcommand{\Dock}{\textbf{Dock}\xspace}
\newcommand{\award}{\textbf{award}\xspace}
\newcommand{\Award}{\textbf{Award}\xspace}


% % Optional: instructor contact line (leave blank to hide)
% \newcommand{\StaffLine}{}

% --- Small helpers ---
\newcommand{\MetaRow}[2]{\textbf{#1:} #2\\}
\newcommand{\Section}[1]{\vspace{0.8em}\noindent\textbf{#1}\par\vspace{0.3em}}

% --- Auto points total support ---
\newcounter{mae@points}
\newcommand{\PointsRow}[2]{#1 & #2\addtocounter{mae@points}{#2} \\}
\newcommand{\PointsTotal}{\arabic{mae@points}}

\newcommand{\maeHandoutTypeRubric}{Rubric}

\newcommand{\MakeHandoutHeader}{%
  % Header line like your PDFs
  \fancyhead[L]{\CourseCode~--~\CourseTitle}
  \fancyhead[R]{\Semester}
  \begin{center}
    {\Large\textbf{\HandoutType\ifx\HandoutNumber\empty\else~\HandoutNumber\fi: \HandoutTitle}}\par
    \vspace{0.6em}
  \end{center}
  \hrule
  \ifx\HandoutType\maeHandoutTypeRubric
    \vspace{0.6em}
  \else
    \vspace{0.9em}
    \noindent
    \MetaRow{Due Date}{\DueDate}
    \MetaRow{Type}{\TeamType}
%   \ifx\StaffLine\empty\else
%     \MetaRow{}{ \StaffLine }
%   \fi
%   \vspace{0.5em}
    \hrule
    \vspace{0.9em}
  \fi
}

% --- Deliverables block: numbered list with bold labels ---
\newenvironment{Deliverables}
{\begin{enumerate}[label=\arabic*)]}
{\end{enumerate}}

% --- Points table with automatic total ---
\newcommand{\PointsTableAuto}[1]{%
  \Section{Points Rubric}
  \setcounter{mae@points}{0}%
  \noindent\begin{tabularx}{\textwidth}{@{}X r@{}}
    \toprule
    #1
    \midrule
    \textbf{Total} & \textbf{\PointsTotal} \\
    \bottomrule
  \end{tabularx}
}

% --- Example: image + caption block (for tutorial screenshots, sketches, etc.) ---
\newcommand{\ExampleFigure}[3]{%
  \begin{figure}[h!]
    \centering
    \includegraphics[width=#2\textwidth]{#1}
    \caption{#3}
  \end{figure}
}

\newtcolorbox{boxK}{
    sharpish corners, % better drop shadow
    boxrule = 0pt,
    toprule = 4.5pt, % top rule weight
    enhanced,
    fuzzy shadow = {0pt}{-2pt}{-0.5pt}{0.5pt}{black!35} % {xshift}{yshift}{offset}{step}{options} 
}